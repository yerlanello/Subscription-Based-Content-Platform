# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=diploma

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING_MIN_32_CHARS

# ─── MinIO (S3-хранилище файлов) ─────────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_STRONG_PASSWORD
MINIO_BUCKET=media
MINIO_PUBLIC_URL=http://YOUR_VPS_IP:9000

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ─── Email (SMTP via Brevo) ──────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@smtp-brevo.com
SMTP_PASS=CHANGE_ME_BREVO_SMTP_KEY
SMTP_FROM=noreply@yourdomain.com

# ─── LiveKit (стриминг) ──────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME

# ─── Zilliz Cloud (managed Milvus) ───────────────────────────────────────────
MILVUS_ADDR=https://your-cluster.serverless.aws-eu-central-1.cloud.zilliz.com
MILVUS_API_KEY=CHANGE_ME

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
APP_URL=https://yourdomain.com

# ─── Порт сервера ─────────────────────────────────────────────────────────────
PORT=8080
