# Local development overrides for docker-compose.yml
# Copy to ".env" and change the values before any non-local use.
# If this file is absent, docker-compose falls back to the defaults
# shown below, so the dev stack still works out of the box.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=diploma

# Used for MinIO root credentials and Milvus' MinIO access.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
